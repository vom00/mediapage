# Copy to .env.local.
# For offline development against the Firebase emulators:
NEXT_PUBLIC_FIREBASE_EMULATORS=1

# For a real Firebase project (values from Project settings > Your apps):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side API keys (never NEXT_PUBLIC_).
# Movies and TV (required for live data): https://www.themoviedb.org/settings/api
# TMDB_API_KEY=
# Video games — IGDB, every platform (optional). Without these the games
# shelf falls back to keyless Steam search. Free Twitch app credentials:
# https://dev.twitch.tv/console/apps
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# Anime (AniList + Jikan), books (Open Library), and music (Deezer)
# need no keys.

# Test-only base URL overrides (set automatically by the E2E config;
# leave unset for real upstreams):
# TMDB_BASE_URL= / TMDB_IMAGE_BASE= / ANILIST_BASE_URL= / JIKAN_BASE_URL=
# STEAM_BASE_URL= / STEAM_IMAGE_BASE= / IGDB_BASE_URL= / IGDB_TOKEN_URL=
# IGDB_IMAGE_BASE= / OPENLIBRARY_BASE_URL= / OPENLIBRARY_COVER_BASE=
# DEEZER_BASE_URL=
